APP_ENV=development
LAN_HOSTNAME=healthdocs.lan
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://healthdocs:healthdocs@postgres:5432/healthdocs
REDIS_URL=redis://redis:6379/0
WATCH_DIRECTORY=/data/inbox
STORAGE_ROOT=/data
AUTH_ENABLED=false
AUTH_PASSWORD_HASH=
SESSION_SECRET=
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
BACKUP_ROOT=/backups
BACKUP_ENCRYPTION_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_TOKEN=
LMSTUDIO_MAIN_MODEL=qwen3.8-27b-abliterated-mtplx-optimized-speed
LMSTUDIO_SIMPLE_MODEL=qwen/qwen3-vl-8b
LMSTUDIO_EXTRACTION_MODEL=qwen/qwen3-vl-8b
LMSTUDIO_FALLBACK_MODEL=qwen3.8-27b-abliterated-mtplx-optimized-speed
LMSTUDIO_RELATION_MODEL=qwen3.8-27b-abliterated-mtplx-optimized-speed
LMSTUDIO_VISION_MODEL=
LMSTUDIO_EMBEDDING_MODEL=
LMSTUDIO_REQUEST_TIMEOUT_SECONDS=1800
RIZZO_FLOW_ENABLED=false
RIZZO_FLOW_BASE_URL=http://host.docker.internal:8788
MEDICAL_EVENT_LOOKBACK_DAYS=365
AUTO_CONFIRM_THRESHOLD=0.95
SUGGEST_THRESHOLD=0.75
AIFA_UPDATE_INTERVAL_DAYS=7
MAX_UPLOAD_REQUEST_OVERHEAD_BYTES=65536
